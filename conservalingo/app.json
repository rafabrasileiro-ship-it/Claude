{
  "expo": {
    "name": "Conservalingo",
    "slug": "conservalingo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9F7F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.conservalingo.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "br.com.conservalingo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#2F6F6A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuild": true,
            "enableShrinkResourcesInReleaseBuild": true,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Conservalingo usa o microfone para ouvir você repetir as frases em inglês e corrigir a pronúncia.",
          "speechRecognitionPermission": "O Conservalingo usa o reconhecimento de fala para avaliar a sua pronúncia, palavra por palavra."
        }
      ],
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6F6A",
          "dark": {
            "backgroundColor": "#2F6F6A",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}